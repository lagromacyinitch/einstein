DirectoryIndex main.html index.php index.html

# Revalidate payment UI so older image links are not reused after updates.
<IfModule mod_headers.c>
    <FilesMatch "^(user\.html|admin\.html|enrollment-flow\.js|main\.css|admin\.css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# config.php belongs in includes/ (already blocked there); this covers a copy
# that is still at the site root.
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</Files>
