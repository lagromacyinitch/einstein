# Local secrets. The committed public/includes/config.php reads credentials from
# .env; keep the legacy project-root config.php and environment files private.
/config.php
.env
.env.*
!.env.example

# Local editor and operating-system files.
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db

# Copied from database/migrations/ by the deploy workflow; never edit here.
/public/includes/migrations/

# Private uploaded receipts and generated OCR cache.
public/uploads/*
!public/uploads/.htaccess
