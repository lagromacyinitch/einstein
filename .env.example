# Copy this file to .env. Do not commit the copy containing real credentials.

# Hostinger Web/Cloud hosting: the application and database are on the same server.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=YOUR_HOSTINGER_DATABASE_NAME
DB_USER=YOUR_HOSTINGER_DATABASE_USER
DB_PASS=YOUR_HOSTINGER_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_AUTO_BOOTSTRAP=false
